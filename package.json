{
  "name": "envshield",
  "version": "0.1.0",
  "description": "Type-safe configuration & secrets management replacing dotenv. Security-first: redacts secrets from logs, deletes them from process.env after loading.",
  "keywords": ["env", "config", "secrets", "dotenv", "security", "type-safe", "zod"],
  "author": "Parth2412",
  "license": "MIT",
  "homepage": "https://github.com/Parth2412/envshield",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parth2412/envshield.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "envshield": "dist/cli/index.js"
  },
  "files": ["dist", "README.md", "SECURITY.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test:coverage && npm run lint && npm run type-check"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@standard-schema/spec": "^1.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
